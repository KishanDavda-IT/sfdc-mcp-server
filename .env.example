# Salesforce MCP Server — Environment Variables
# Copy this file to .env and fill in your credentials.

# Auth mode: "password" (default) or "jwt"
SF_AUTH_MODE=password

# ── Auth Mode A — Username/Password (dev/sandbox) ──
SF_LOGIN_URL=https://login.salesforce.com
SF_USERNAME=your@email.com
SF_PASSWORD=yourpassword
SF_SECURITY_TOKEN=yourSecurityToken

# ── Auth Mode B — Connected App OAuth JWT (production) ──
# SF_AUTH_MODE=jwt
# SF_CLIENT_ID=3MVG9...
# SF_PRIVATE_KEY_PATH=./certs/server.key
# SF_JWT_SUBJECT=your@email.com
# SF_INSTANCE_URL=https://yourorg.my.salesforce.com

# ── Security Controls ──────────────────────────────────────────────

# Rate limiting (per-process sliding window, cost-weighted)
# SF_RATE_LIMIT_MAX=100           # total cost units per window
# SF_RATE_LIMIT_WINDOW_MS=60000   # window size in ms

# Object access control (comma-separated API names)
# SF_ALLOWED_OBJECTS=Account,Contact,Opportunity,Lead,Case
# SF_BLOCKED_OBJECTS=User,PermissionSet,SetupAuditTrail

# Disable destructive tools
# SF_DISABLE_DELETE=true

# Apex — DISABLED by default. Opt in explicitly:
# SF_ENABLE_APEX=true
# SF_APEX_ALLOW_DML=true          # also allow DML in Apex (insert/update/delete)

# ── File System Toolset ──────────────────────────────────────────────
# Root directory for all fs_* tool operations (REQUIRED to use fs tools)
# All paths are sandboxed under this directory — traversal is blocked.
# FS_ROOT_DIR=./force-app

# Max file size for fs_read_file in bytes (default: 5 MB)
# FS_MAX_FILE_SIZE=5242880

# Deploy — DISABLED by default. Opt in explicitly:
# SF_ENABLE_FS_DEPLOY=true
# FS_DEPLOY_TIMEOUT_MS=120000     # deploy timeout in ms (default: 120s)
